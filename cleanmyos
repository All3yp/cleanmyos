def get_distro_info() -> Tuple[str, str, Optional[Path]]:
    """Detects Linux distro pretty name, package manager, and package cache path."""
    pretty_name = "Linux"
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    pretty_name = line.strip().split("=", 1)[1].strip('"\'')
                    break
    except Exception:
        pass

    if shutil.which("pacman"):
        return pretty_name, "pacman", Path("/var/cache/pacman/pkg")
    elif shutil.which("apt-get") or shutil.which("apt"):
        return pretty_name, "apt", Path("/var/cache/apt/archives")
    elif shutil.which("dnf"):
        return pretty_name, "dnf", Path("/var/cache/dnf")
    elif shutil.which("zypper"):
        return pretty_name, "zypper", Path("/var/cache/zypp")
    return pretty_name, "generic", None

def get_dir_size(path: Path) -> int:
    """Calculates size of directory in bytes quickly."""
    if not path.exists():
        return 0
    try:
        res = subprocess.run(
            ["du", "-s", "-B1", str(path)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5
        )
        if res.returncode == 0:
            return int(res.stdout.split()[0])
    except Exception:
        pass
    
    total = 0
    try:
        for entry in os.scandir(path):
            if entry.is_file(follow_symlinks=False):
                total += entry.stat().st_size
            elif entry.is_dir(follow_symlinks=False):
                total += get_dir_size(Path(entry.path))
    except (PermissionError, FileNotFoundError):
        pass
    return total

def format_size(bytes_val: int) -> str:
    """Converts bytes to readable string (KB, MB, GB, TB)."""
    val = float(bytes_val)
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if val < 1024.0 or unit == 'TB':
            return f"{val:.1f} {unit}"
        val /= 1024.0
    return f"{bytes_val} B"

