def get_locales_dir() -> Path:
    """Finds the locales directory (local repo, XDG data, or system)."""
    script_locales = Path(__file__).resolve().parent / "locales"
    if script_locales.exists() and (script_locales / "pt_BR.json").exists():
        return script_locales
    if XDG_LOCALES_DIR.exists():
        return XDG_LOCALES_DIR
    sys_locales = Path("/usr/share/cleanmyos/locales")
    if sys_locales.exists():
        return sys_locales
    return script_locales

def load_lang_preference() -> str:
    """Loads saved language from config file, or detects from system."""
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                lang = data.get("lang")
                if lang in ["pt_BR", "en_US"]:
                    return lang
        except Exception:
            pass
    sys_lang = os.environ.get("LANG", "").lower()
    if sys_lang.startswith("pt"):
        return "pt_BR"
    return "en_US"

def save_lang_preference(lang: str):
    """Saves language preference to config file."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        data = {}
        if CONFIG_FILE.exists():
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
        data["lang"] = lang
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
    except Exception:
        pass

def load_locale_strings(lang: str) -> Dict[str, str]:
    """Loads translations from JSON file."""
    locales_dir = get_locales_dir()
    lang_file = locales_dir / f"{lang}.json"
    if not lang_file.exists():
        lang_file = locales_dir / "pt_BR.json"
    if lang_file.exists():
        try:
            with open(lang_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                return data.get("app", {})
        except Exception:
            pass
    return {}

