def update_system(lang: Optional[str] = None):
    """Updates CleanMyOS by fetching from the original upstream repository and reinstalling."""
    lang = lang or load_lang_preference()
    strings = load_locale_strings(lang)
    t = lambda k, **kw: strings.get(k, k).format(**kw) if kw else strings.get(k, k)

    console.print(f"[cyan]{t('updating', url=ORIGINAL_REPO_URL)}[/cyan]")

    repo_path = None
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                p = data.get("repo_path")
                if p and Path(p).exists() and (Path(p) / ".git").exists():
                    repo_path = Path(p)
        except Exception:
            pass

    if not repo_path:
        candidate = Path(__file__).resolve().parent
        if (candidate / ".git").exists():
            repo_path = candidate

    if not repo_path:
        fallback_repo = XDG_DATA_DIR / "repo"
        if (fallback_repo / ".git").exists():
            repo_path = fallback_repo
        else:
            try:
                XDG_DATA_DIR.mkdir(parents=True, exist_ok=True)
                console.print(f"[dim]Clonando repositório para {fallback_repo}...[/dim]")
                subprocess.run(["git", "clone", ORIGINAL_REPO_URL, str(fallback_repo)], check=True)
                repo_path = fallback_repo
            except Exception as e:
                console.print(f"[red]{t('update_error', err=str(e))}[/red]")
                return

    try:
        remotes_out = subprocess.run(
            ["git", "-C", str(repo_path), "remote", "-v"],
            stdout=subprocess.PIPE, text=True, check=True
        ).stdout

        target_remote = "origin"
        if ORIGINAL_REPO_URL in remotes_out:
            for line in remotes_out.splitlines():
                if ORIGINAL_REPO_URL in line:
                    target_remote = line.split()[0]
                    break
        else:
            if "upstream" not in remotes_out:
                subprocess.run(["git", "-C", str(repo_path), "remote", "add", "upstream", ORIGINAL_REPO_URL], check=True)
            else:
                subprocess.run(["git", "-C", str(repo_path), "remote", "set-url", "upstream", ORIGINAL_REPO_URL], check=True)
            target_remote = "upstream"

        subprocess.run(["git", "-C", str(repo_path), "fetch", target_remote, "main"], check=True)

        local_head = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", "HEAD"],
            stdout=subprocess.PIPE, text=True, check=True
        ).stdout.strip()

        remote_head = subprocess.run(
            ["git", "-C", str(repo_path), "rev-parse", f"{target_remote}/main"],
            stdout=subprocess.PIPE, text=True, check=True
        ).stdout.strip()

        if local_head == remote_head:
            console.print(f"[green]{t('already_latest')}[/green]")
            return

        subprocess.run(["git", "-C", str(repo_path), "pull", "--rebase", target_remote, "main"], check=True)

        install_script = repo_path / "install.sh"
        if install_script.exists():
            subprocess.run([str(install_script), f"--lang={'en' if lang == 'en_US' else 'pt'}"], check=True)

        console.print(f"[bold green]{t('update_success')}[/bold green]")
    except Exception as e:
        console.print(f"[red]{t('update_error', err=str(e))}[/red]")

def install_system(lang: Optional[str] = None):
    """Installs CleanMyOS and its JSON locales to ~/.local and configures shell PATH."""
    lang = lang or load_lang_preference()
    t_dict = load_locale_strings(lang)

    target_bin_dir = HOME / ".local/bin"
    target_bin_dir.mkdir(parents=True, exist_ok=True)
    target_bin = target_bin_dir / "cleanmyos"
    target_symlink = target_bin_dir / "clean"
    
    current_script = Path(__file__).resolve()
    if current_script != target_bin:
        shutil.copy2(current_script, target_bin)
    
    target_bin.chmod(0o755)
    if target_symlink.exists() or target_symlink.is_symlink():
        target_symlink.unlink()
    target_symlink.symlink_to(target_bin)
    
    # Copy locales to ~/.local/share/cleanmyos/locales/
    src_locales = get_locales_dir()
    if src_locales.exists():
        XDG_LOCALES_DIR.mkdir(parents=True, exist_ok=True)
        for loc in src_locales.glob("*.json"):
            shutil.copy2(loc, XDG_LOCALES_DIR / loc.name)

    if lang:
        save_lang_preference(lang)

    try:
        script_dir = Path(__file__).resolve().parent
        if (script_dir / ".git").exists():
            cfg = {}
            if CONFIG_FILE.exists():
                with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
            cfg["repo_path"] = str(script_dir)
            cfg["upstream_url"] = ORIGINAL_REPO_URL
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2)
    except Exception:
        pass

    console.print(f"[bold green]{t_dict.get('installed_to', 'CleanMyOS installed in: {bin}').format(bin=str(target_bin))}[/bold green]")
    console.print(f"[bold green]{t_dict.get('shortcut_created', 'Shortcut created: {symlink}').format(symlink=str(target_symlink))}[/bold green]")
    
    user_shell = os.environ.get("SHELL", "")
    shell_name = Path(user_shell).name if user_shell else "bash"
    str_target = str(target_bin_dir)

    configured = False
    if shell_name == "fish":
        fish_config = HOME / ".config/fish/config.fish"
        if fish_config.exists():
            content = fish_config.read_text()
            if str_target not in content:
                with open(fish_config, "a") as f:
                    f.write(f"\n# CleanMyOS PATH\nfish_add_path {str_target}\n")
                console.print(f"[green]{t_dict.get('added_to_shell', 'Added to {shell}: {config}').format(shell='Fish Shell', config=str(fish_config))}[/green]")
            configured = True
    elif shell_name == "zsh":
        zsh_config = HOME / ".zshrc"
        if zsh_config.exists():
            content = zsh_config.read_text()
            if str_target not in content:
                with open(zsh_config, "a") as f:
                    f.write(f'\n# CleanMyOS PATH\nexport PATH="{str_target}:$PATH"\n')
                console.print(f"[green]{t_dict.get('added_to_shell', 'Added to {shell}: {config}').format(shell='Zsh', config=str(zsh_config))}[/green]")
            configured = True
    elif shell_name == "bash":
        bash_config = HOME / ".bashrc"
        if bash_config.exists():
            content = bash_config.read_text()
            if str_target not in content:
                with open(bash_config, "a") as f:
                    f.write(f'\n# CleanMyOS PATH\nexport PATH="{str_target}:$PATH"\n')
                console.print(f"[green]{t_dict.get('added_to_shell', 'Added to {shell}: {config}').format(shell='Bash', config=str(bash_config))}[/green]")
            configured = True

    if not configured:
        profile = HOME / ".profile"
        if profile.exists():
            content = profile.read_text()
            if str_target not in content:
                with open(profile, "a") as f:
                    f.write(f'\n# CleanMyOS PATH\nexport PATH="{str_target}:$PATH"\n')
                console.print(f"[green]{t_dict.get('added_to_profile', 'Added to ~/.profile')}[/green]")

    console.print(f"[bold green]{t_dict.get('install_success', 'Installation finished successfully!')}[/bold green]")

def main():
    current_lang = load_lang_preference()
    
    # Check for --lang argument in sys.argv
    for i, a in enumerate(sys.argv):
        if a.startswith("--lang="):
            val = a.split("=", 1)[1].lower()
            current_lang = "pt_BR" if "pt" in val else "en_US"
            save_lang_preference(current_lang)
            sys.argv.pop(i)
            break
        elif a == "--lang" and i + 1 < len(sys.argv):
            val = sys.argv[i + 1].lower()
            current_lang = "pt_BR" if "pt" in val else "en_US"
            save_lang_preference(current_lang)
            sys.argv.pop(i + 1)
            sys.argv.pop(i)
            break

    app = CleanMyOS(lang=current_lang)

    if len(sys.argv) == 1:
        print_help(lang=current_lang)
        return

    arg = sys.argv[1].lower()
    if arg in ["--interactive", "-i", "--ui"]:
        app.run_interactive()
    elif arg in ["--scan", "-s"]:
        app.scan_all()
        app.print_dashboard()
        app.print_anti_stutter_tips()
        app.print_large_files()
    elif arg in ["--clean-all", "-y"]:
        app.scan_all()
        app.clean_category(app.t("cat_trash"))
        app.clean_category(app.t("cat_dev"))
        app.clean_category(app.t("cat_browsers"))
        app.clean_category(app.t("cat_system"))
        console.print(f"[green]{app.t('clean_auto_done')}[/green]")
    elif arg in ["--large", "-l"]:
        app.print_large_files()
    elif arg in ["--update", "-u"]:
        update_system(lang=current_lang)
    elif arg in ["--install"]:
        install_system(lang=current_lang)
    elif arg in ["--help", "-h"]:
        print_help(lang=current_lang)
    else:
        err_msg = app.t("unknown_option", arg=arg)
        console.print(f"[red]{err_msg}[/red]")
        print_help(lang=current_lang)

if __name__ == "__main__":
    main()
